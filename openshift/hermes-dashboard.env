# Separate dashboard deployment that can run alongside the Telegram gateway.

NAMESPACE=dl-playground-arpit
APP_NAME=hermes-dashboard
INHERIT_SECRET_NAME=hermes-agent-secrets
PROXY_SECRET_NAME=my-proxy-whitelist

HERMES_IMAGE=ghcr.io/arpitsharma-vw/hermes-on-openshift:sha-1e2d30c
IMAGE_PULL_POLICY=IfNotPresent
REPLICAS=1
IMAGE_PULL_SECRET=ghcr-pull-secret

GHCR_USERNAME=arpitsharma-vw
GHCR_TOKEN=

HERMES_HOME=/opt/hermes/.hermes
PVC_NAME=hermes-home
PVC_SIZE=5Gi
STORAGE_CLASS=

HERMES_RUN_MODE=dashboard
HERMES_DASHBOARD_PORT=9119
HERMES_INFERENCE_PROVIDER=azure-foundry
HERMES_INFERENCE_MODEL=gpt-4.1
AZURE_FOUNDRY_BASE_URL=https://monkeychaos.services.ai.azure.com/api/projects/monkeychaos-default/openai/v1

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
NODE_USE_ENV_PROXY=1

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AZURE_FOUNDRY_API_KEY=
GH_TOKEN=

TELEGRAM_BOT_TOKEN=
GATEWAY_ALLOW_ALL_USERS=
TELEGRAM_ALLOWED_USERS=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=