# Copy this file to openshift/hermes.env and fill values before deployment.

# Target namespace and app identity
NAMESPACE=hermes-agent
APP_NAME=hermes-agent

# Container image that contains the Hermes CLI binary.
# Set this to your tested image in your internal registry or public registry.
HERMES_IMAGE=
IMAGE_PULL_POLICY=IfNotPresent
REPLICAS=1
# If pulling from a private registry (for example GHCR private image), create this secret first.
IMAGE_PULL_SECRET=ghcr-pull-secret

# GHCR pull-secret helper inputs (used by scripts/ocp-create-ghcr-pull-secret.sh).
GHCR_USERNAME=
GHCR_TOKEN=

# Hermes runtime layout
HERMES_HOME=/opt/hermes/.hermes
PVC_NAME=hermes-home
PVC_SIZE=5Gi
STORAGE_CLASS=

# Run mode:
# - gateway: starts "hermes gateway"
# - chat: starts "hermes"
# - dashboard: starts web dashboard for browser access
# - idle: keeps pod running for interactive exec/debug
HERMES_RUN_MODE=gateway
HERMES_DASHBOARD_PORT=9119
HERMES_INFERENCE_PROVIDER=
HERMES_INFERENCE_MODEL=
HERMES_INFERENCE_API_MODE=
AZURE_FOUNDRY_BASE_URL=
AZURE_ANTHROPIC_KEY=

# VW LLM Gateway (llmaas) OAuth2 credentials.
# Populate these to use the internal llmgateway with gpt-oss-120b.
# The deploy script fetches an access token at pod startup and sets AZURE_FOUNDRY_API_KEY.
LLMAAS_TOKEN_URL=https://idp.cloud.vwgroup.com/auth/realms/kums-mfa/protocol/openid-connect/token
LLMAAS_CLIENT_ID=
LLMAAS_CLIENT_SECRET=
LLMAAS_VIRTUAL_KEY=

# Optional proxy vars for restricted egress clusters
# Prefer PROXY_SECRET_NAME with HTTP_PROXY/HTTPS_PROXY/NO_PROXY keys in OpenShift Secret.
# Also supports my-proxy-whitelist style keys:
# http-proxy-url/http-proxy-port/https-proxy-url/https-proxy-port/proxy-user/proxy-password
PROXY_SECRET_NAME=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
NODE_USE_ENV_PROXY=1

# LLM/API keys (at least one usually required)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AZURE_FOUNDRY_API_KEY=
GH_TOKEN=

# Optional gateway-specific secrets if your channel setup needs them
TELEGRAM_BOT_TOKEN=
GATEWAY_ALLOW_ALL_USERS=
TELEGRAM_ALLOWED_USERS=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
