# Separate dashboard deployment that shares the same Hermes state volume as the gateway.

NAMESPACE=hermes-agent
APP_NAME=hermes-dashboard
INHERIT_SECRET_NAME=hermes-agent-secrets
PROXY_SECRET_NAME=

HERMES_IMAGE=
IMAGE_PULL_POLICY=IfNotPresent
REPLICAS=1
IMAGE_PULL_SECRET=ghcr-pull-secret

GHCR_USERNAME=
GHCR_TOKEN=

HERMES_HOME=/opt/hermes/.hermes
PVC_NAME=hermes-home
PVC_SIZE=5Gi
STORAGE_CLASS=

HERMES_RUN_MODE=dashboard
HERMES_DASHBOARD_PORT=9119
HERMES_INFERENCE_PROVIDER=azure-foundry
HERMES_INFERENCE_MODEL=gpt-4.1
AZURE_FOUNDRY_BASE_URL=

# Prefer PROXY_SECRET_NAME with HTTP_PROXY/HTTPS_PROXY/NO_PROXY keys in OpenShift Secret.
# Also supports my-proxy-whitelist style keys:
# http-proxy-url/http-proxy-port/https-proxy-url/https-proxy-port/proxy-user/proxy-password
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
NODE_USE_ENV_PROXY=1

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AZURE_FOUNDRY_API_KEY=
GH_TOKEN=

TELEGRAM_BOT_TOKEN=
GATEWAY_ALLOW_ALL_USERS=
TELEGRAM_ALLOWED_USERS=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
